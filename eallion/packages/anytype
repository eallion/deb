DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"

get_github_releases "anyproto/anytype-ts"

if [ "${ACTION}" != "prettylist" ]; then
    case "${HOST_ARCH}" in
        amd64) TARGET_ARCH="(amd64|x86_64)" ;;
        arm64) TARGET_ARCH="(arm64|aarch64)" ;;
        *) TARGET_ARCH="${HOST_ARCH}" ;;
    esac

    if [ "${DEBGET_CHANNEL}" = "beta" ] || [ "${DEBGET_PRERELEASE}" = "1" ]; then
        URL=$(grep -E "browser_download_url.*anytype_.*${TARGET_ARCH}\.deb\"" "${CACHE_FILE}" 2>/dev/null | head -n 1 | cut -d '"' -f 4)
    else
        # 默认过滤测试版本，锁定稳定正式版
        URL=$(grep -E "browser_download_url.*anytype_.*${TARGET_ARCH}\.deb\"" "${CACHE_FILE}" 2>/dev/null | grep -vEi '(alpha|beta|rc|preview|dev)' | head -n 1 | cut -d '"' -f 4)
        # 容错回退：若缓存中仅有测试版资产，保底匹配，避免导致校验阻断
        [ -z "${URL}" ] && URL=$(grep -E "browser_download_url.*anytype_.*${TARGET_ARCH}\.deb\"" "${CACHE_FILE}" 2>/dev/null | head -n 1 | cut -d '"' -f 4)
    fi

    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL}" | sed -E 's/^v//')
fi

PRETTY_NAME="Anytype"
WEBSITE="https://anytype.io/"
SUMMARY="Official desktop client for Anytype."
