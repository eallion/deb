DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"

get_github_releases "chen08209/FlClash"

if [ "${ACTION}" != "prettylist" ]; then
    case "${HOST_ARCH}" in
        amd64) TARGET_ARCH="(amd64|x86_64)" ;;
        arm64) TARGET_ARCH="(arm64|aarch64)" ;;
        *) TARGET_ARCH="${HOST_ARCH}" ;;
    esac

    if [ "${DEBGET_CHANNEL}" = "beta" ] || [ "${DEBGET_PRERELEASE}" = "1" ]; then
        URL=$(grep -E "browser_download_url.*FlClash.*-linux-${TARGET_ARCH}\.deb\"" "${CACHE_FILE}" 2>/dev/null | grep -vi -- '-rs\.' | head -n 1 | cut -d '"' -f 4)
    else
        URL=$(grep -E "browser_download_url.*FlClash.*-linux-${TARGET_ARCH}\.deb\"" "${CACHE_FILE}" 2>/dev/null | grep -vEi '(alpha|beta|rc|preview|dev|nightly|pre|rs)' | head -n 1 | cut -d '"' -f 4)
        [ -z "${URL}" ] && URL=$(grep -E "browser_download_url.*FlClash.*-linux-${TARGET_ARCH}\.deb\"" "${CACHE_FILE}" 2>/dev/null | grep -vi -- '-rs\.' | head -n 1 | cut -d '"' -f 4)
    fi

    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL}" | sed -E 's/^v//')
fi

PRETTY_NAME="FlClash"
WEBSITE="https://github.com/chen08209/FlClash"
SUMMARY="A multi-platform proxy client based on ClashMeta, simple and easy to use."
