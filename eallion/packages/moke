DEFVER=1
ARCHS_SUPPORTED="amd64"

get_github_releases "talebook/moke"

if [ "${ACTION}" != "prettylist" ]; then
    if [ "${DEBGET_CHANNEL}" = "beta" ] || [ "${DEBGET_PRERELEASE}" = "1" ]; then
        URL=$(grep -E "browser_download_url.*Moke_.*_amd64\.deb\"" "${CACHE_FILE}" 2>/dev/null | head -n 1 | cut -d '"' -f 4)
    else
        URL=$(grep -E "browser_download_url.*Moke_.*_amd64\.deb\"" "${CACHE_FILE}" 2>/dev/null | grep -vEi '(alpha|beta|rc|preview|dev)' | head -n 1 | cut -d '"' -f 4)
        [ -z "${URL}" ] && URL=$(grep -E "browser_download_url.*Moke_.*_amd64\.deb\"" "${CACHE_FILE}" 2>/dev/null | head -n 1 | cut -d '"' -f 4)
    fi

    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL}" | sed -E 's/^v//')
fi

PRETTY_NAME="Talebook Moke"
WEBSITE="https://github.com/talebook/moke"
SUMMARY="Cross-platform client for Talebook personal library servers."
